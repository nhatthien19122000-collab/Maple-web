# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — it will NOT be committed or pushed to GitHub.

# Resend (https://resend.com) — used to email contact-form submissions.
# Get an API key from the Resend dashboard → API Keys → Create API Key.
RESEND_API_KEY=

# Who receives the inquiry notification emails.
CONTACT_TO_EMAIL=lam@maplefurniture.vn
