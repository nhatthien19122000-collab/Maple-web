# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — it will NOT be committed or pushed to GitHub.

# Office 365 SMTP settings (used to email contact-form submissions)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=lam@maplefurniture.vn
# App password generated for this mailbox (Microsoft 365 admin center → Security → App passwords),
# or the account password if "Authenticated SMTP" is enabled and MFA/app-password is not required.
SMTP_PASS=

# Who receives the inquiry notification emails. Defaults to SMTP_USER if omitted.
CONTACT_TO_EMAIL=lam@maplefurniture.vn
