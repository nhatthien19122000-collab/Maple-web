# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — it will NOT be committed or pushed to GitHub.

# Gmail account used to SEND contact-form notification emails.
GMAIL_USER=rnd.team.maple@gmail.com
# App password for that Gmail account (Google Account → Security →
# 2-Step Verification must be ON first → App passwords → create one).
# This is NOT the normal Gmail login password.
GMAIL_APP_PASSWORD=

# Who RECEIVES the inquiry notification emails. Comma-separate for multiple.
CONTACT_TO_EMAIL=lam@maplefurniture.vn,Rnd@maplefurniture.vn
